# Copy to .env (or set in Railway → Variables)

# One-click demo logins for every dashboard, with sample data. ON unless set to false.
# MUST be false once real customers use the site: the demo admin/compliance/support/finance accounts can see real data.
DEMO_MODE=true
PORT=4000
NODE_ENV=production
# Long random string. Required in production so sign-ins survive restarts.
JWT_SECRET=change-me-to-a-long-random-string
# Persistent storage folder. On Railway, attach a volume mounted at /data.
DATA_DIR=/data
# First Super Admin account, created on boot if it does not exist.
ADMIN_EMAIL=admin@yourdomain.co.za
ADMIN_PASSWORD=choose-a-strong-password
ADMIN_NAME=DROP Administrator
# Encrypts uploaded ID documents at rest. Long random string; keep a safe copy. Changing or losing it makes stored documents unreadable.
FILE_ENCRYPTION_KEY=change-me-to-a-different-long-random-string
# When passengers/businesses may book: submitted (documents sent, default) | verified (only after approval) | off
PASSENGER_VERIFICATION=submitted
# Driver service fee (0.10 = 10%). Passenger platform commission is always R0.
DRIVER_SERVICE_FEE_RATE=0.10
# Public contact address shown by the API
CONTACT_EMAIL=hello@drop.co.za
# Only needed if the frontend is hosted on a different domain from the API
CORS_ORIGINS=

# ---------- Payments ----------
# Public site address; Paystack returns passengers here after checkout
PUBLIC_URL=https://your-domain.co.za
# Paystack (passenger card payments → settles to the DROP pool bank account)
PAYSTACK_SECRET_KEY=
# Driver withdrawals (rands)
WITHDRAWAL_MIN=50
WITHDRAWAL_FEE=0
# Drivers who owe more than this in cash-trip service fees cannot accept cash trips (rands)
CASH_DEBT_LIMIT=300

# ---------- Paymentology (DROP Driver Card, Sprint Companion API) ----------
# off | sandbox | live
PAYMENTOLOGY_MODE=off
PAYMENTOLOGY_TERMINAL_ID=
PAYMENTOLOGY_TERMINAL_PASSWORD=
PAYMENTOLOGY_LOCAL_API_URL=
# Comma-separated Paymentology source IPs allowed to call /api/paymentology/remote
PAYMENTOLOGY_ALLOWED_IPS=
# Confirm both with Paymentology's Checksum Generator during UAT
PAYMENTOLOGY_CHECKSUM_ALGO=sha256
PAYMENTOLOGY_CHECKSUM_CASE=upper
CARD_PROGRAMME_NAME=DROP Driver Card
CARD_EXPIRY_YEARS=3
# Spending policy (rands)
CARD_MAX_TRANSACTION=5000
CARD_DAILY_LIMIT=10000
CARD_ALLOW_ATM=true
# Merchant category codes to decline (gambling, betting, lotteries, government lotteries)
CARD_BLOCKED_MCCS=7995,7800,7801,7802,9406

# ---- Driver ↔ passenger communication (docs/COMMUNICATION.md) ----
# Phone calls on registered numbers: masked (Twilio, numbers hidden) | direct (dialler, number shown during trip) | off
# Default: masked when Twilio is configured, otherwise direct.
PHONE_CALLS=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# A South African DROP number from Twilio, e.g. +27871234567. Both sides see this number.
TWILIO_FROM_NUMBER=
PHONE_CALL_MAX_SECONDS=1800
# Hours chat and calls stay open after a trip ends (lost items)
COMMS_WINDOW_HOURS=2
# In-app voice/video (WebRTC). STUN is free; add a TURN server so calls connect on all mobile networks.
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
TURN_URLS=
# Either a coturn shared secret (short-lived credentials) or a fixed username/credential
TURN_SECRET=
TURN_USERNAME=
TURN_CREDENTIAL=
